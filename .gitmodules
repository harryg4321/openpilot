# Frozen backup of Ian-Boraks/openpilot:zoompilot at 88a8903dc2e50b342446787e48afe923cbbdc51b.
# The behavior is Ian's known-working version; only this opendbc URL is repointed
# to harryg4321's frozen copy so the backup remains self-contained.
[submodule "panda"]
  path = panda
  url = https://github.com/sunnyhaibin/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/harryg4321/opendbc.git
  branch = ian-no-warning-backup
[submodule "msgq"]
  path = msgq_repo
  url = https://github.com/sunnypilot/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/sunnypilot/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
	path = openpilot/sunnypilot/neural_network_data
  url = https://github.com/sunnypilot/neural-network-data.git
